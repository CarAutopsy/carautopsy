{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/CarAutopsy/carautopsy/schemas/vehicle-variant.schema.json",
  "title": "CarAutopsy Vehicle Variant",
  "description": "Structural contract for a vehicle variant. Sparse records remain valid while completeness and source quality are handled by catalog quality gates.",
  "type": "object",
  "required": [
    "schema_version",
    "variant_id",
    "status",
    "identity",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "minLength": 1
    },
    "variant_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "identity": {
      "type": "object",
      "required": [
        "make"
      ],
      "properties": {
        "make": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": [
            "string",
            "null"
          ]
        },
        "powertrain": {
          "type": [
            "string",
            "null"
          ]
        },
        "model_year_from": {
          "type": [
            "integer",
            "null"
          ]
        },
        "model_year_to": {
          "type": [
            "integer",
            "null"
          ]
        },
        "doors": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "seats": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "vehicle_class": {
          "type": [
            "string",
            "null"
          ],
          "description": "Registration certificate vehicle class, e.g. M1."
        }
      },
      "additionalProperties": true
    },
    "performance": {
      "type": "object",
      "properties": {
        "power_w": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0
        },
        "torque_nm": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0
        },
        "accel_0_100_s": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "top_speed_kmh": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "drive": {
          "type": [
            "string",
            "null"
          ]
        },
        "combustion_engine_power_w": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Combustion engine power in watts; required for ICE/HEV/PHEV motor tax."
        },
        "electric_motor_continuous_power_w": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Electric motor nominal continuous rated power in watts; required for M1 BEV motor tax."
        }
      },
      "additionalProperties": true
    },
    "energy": {
      "type": "object"
    },
    "dimensions": {
      "type": "object",
      "properties": {
        "own_weight_kg": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Eigengewicht in kg from registration certificate; required for M1 BEV motor tax."
        },
        "max_permissible_mass_kg": {
          "type": [
            "integer",
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Technically permissible maximum laden mass in kg; Austrian M1 motor-tax schedule applies up to 3500 kg."
        }
      }
    },
    "emissions": {
      "type": "object",
      "properties": {
        "co2_wltp_gpkm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "co2_wltp_weighted_combined_gpkm": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "description": "Weighted combined WLTP CO2 g/km for plug-in hybrids."
        }
      },
      "additionalProperties": true
    },
    "offers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "offer_id": {
            "type": "string",
            "minLength": 1
          },
          "country": {
            "type": "string",
            "minLength": 2
          },
          "currency": {
            "type": "string",
            "minLength": 3,
            "maxLength": 3
          },
          "list_price_minor": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "purchase_price_excl_vat_eur": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "description": "NoVA taxable purchase base in EUR excluding VAT and NoVA; do not infer from list_price_minor."
          }
        },
        "additionalProperties": true
      }
    },
    "warranty": {
      "type": "object"
    },
    "extensions": {
      "type": "object"
    },
    "provenance": {
      "type": "object",
      "required": [
        "confidence"
      ],
      "properties": {
        "confidence": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "official"
          ]
        },
        "reviewed_by": {
          "type": [
            "string",
            "null"
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "claim_evidence": {
          "type": "array",
          "description": "Claim-level evidence spans consumed by scripts/hive_candidate.py. The schema validates span shape and count only; the helper enforces claim coverage for non-null decision-relevant fields under its configured claim roots, excluding identity.make, identity.model and offers[].offer_id; variant_id is checked separately against the reserved task. The helper is not yet wired into the live research pipeline; see Issue #37.",
          "items": {
            "type": "object",
            "required": [
              "claim_path",
              "source_id",
              "locator",
              "quote"
            ],
            "properties": {
              "claim_path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "source_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "locator": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "quote": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              }
            }
          },
          "maxItems": 200
        }
      },
      "additionalProperties": true
    },
    "registration": {
      "type": "object",
      "properties": {
        "first_registration_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date",
          "description": "First registration anywhere (worldwide/Union), not current Austrian registration date."
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
