      "allowed_fields": [
        "make",
        "model",
        "variant",
        "model_year",
        "fuel_type",
        "body_style",
        "power",
        "engine",
        "transmission",
        "dimensions",
        "weight",
        "price_candidate"
      ],
      "forbidden_fields": [
        "vin",
        "owner_personal_data",
        "secret",
        "api_key"
      ],
      "provenance_required": true,
